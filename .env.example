# --- Supabase (use the SERVICE ROLE key; never expose it publicly) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Bot ---
BOT_NAME=Captain-XMD
PREFIX=.

# Password for the dashboard. Without it anyone with the URL can add or remove bots.
DASHBOARD_PASSWORD=

# How many WhatsApp numbers (bots) may run at the same time.
# Default is 100. Each bot uses roughly 60-100 MB RAM, so 100 bots needs a VPS with
# about 8 GB RAM. Free Render (512 MB) only fits 3-4: lower this number there.
MAX_SESSIONS=100
# Boot reconnects bots in batches (default 5 every 4 seconds) to avoid a connection storm.
START_BATCH_SIZE=5
START_BATCH_DELAY_MS=4000

# Deployment admins (comma separated, digits only). These numbers can run owner
# commands on every bot. The number that links a bot is always its owner.
OWNER_NUMBER=

# --- Optional ---
# Time zone used in .menu / .time / the connected message
TIMEZONE=Africa/Nairobi
# Use your own menu picture (direct image link). Leave empty to use assets/menu.jpg
MENU_IMAGE_URL=
# Set to info or debug to see more Baileys logs
LOG_LEVEL=warn

# When a user logs out from their phone, WhatsApp closes that account's connection, so the bot
# cannot message them from their own number any more. Set this to 1 and another connected bot of
# this deployment will send the goodbye message instead. Default: off.
GOODBYE_VIA_OTHER_BOT=0

# Every number that links is added once to this group and channel (links or codes, comma separated).
# Defaults are built in; set to "none" to disable.
# AUTO_JOIN_GROUPS=https://chat.whatsapp.com/LpHONqMdieVAqj42x2mIKi
# AUTO_JOIN_CHANNELS=https://whatsapp.com/channel/0029VbBwDHQG8l5I2Tjvv51G

# --- Legacy single-bot deployment (optional) ---
# Set SESSION_ID when upgrading an old deployment so its existing login is imported.
# SESSION_ID=captain-xmd
# First number to pair automatically for that imported bot.
# PAIR_NUMBER=

# --- AI commands (.gpt .deepseek .gemini .claude .copilot .blackbox .islamai .texttoimage) ---
# They use the free Pollinations service, no key needed. Optional overrides:
# AI_BASE_URL=https://text.pollinations.ai
# AI_IMAGE_URL=https://image.pollinations.ai/prompt
# AI_MODELS={"gpt":"openai","deepseek":"deepseek","gemini":"gemini","claude":"claude"}
