# --- Supabase (use the SERVICE ROLE key; never expose it publicly) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Bot ---
BOT_NAME=Captain-XMD
PREFIX=.
# Number of the WhatsApp account the bot will run on, country code, digits only (e.g. 254712345678)
PAIR_NUMBER=
# Optional: password required on the pairing website (stops strangers linking their number first)
PAIR_PASSWORD=
# Owner number(s), comma separated, digits only
OWNER_NUMBER=
# Name used to namespace this bot's rows in Supabase (change it to run several bots on one table)
SESSION_ID=captain-xmd

# --- Optional ---
# Time zone used in .menu / .time / the connected message
TIMEZONE=Africa/Nairobi
# Use your own menu picture (direct image link). Leave empty to use assets/menu.jpg
MENU_IMAGE_URL=
# Set to info or debug to see more Baileys logs
LOG_LEVEL=warn
